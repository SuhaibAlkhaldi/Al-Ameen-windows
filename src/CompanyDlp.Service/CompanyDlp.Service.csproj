<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWindowsService>true</UseWindowsService>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CompanyDlp.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CompanyDlp.Contracts\CompanyDlp.Contracts.csproj" />
    <ProjectReference Include="..\CompanyDlp.Core\CompanyDlp.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Local entity-detection model assets (ONNX export + SentencePiece tokenizer) - large binaries,
         deployed alongside the agent but never committed to source control (see .gitignore). -->
    <None Include="AiModel\**" CopyToOutputDirectory="PreserveNewest" Condition="Exists('AiModel')" />
    <!-- Tesseract OCR language data (eng/ara .traineddata, tessdata_fast variant) - same
         never-committed, deployed-alongside-the-agent policy as AiModel above. -->
    <None Include="TessData\**" CopyToOutputDirectory="PreserveNewest" Condition="Exists('TessData')" />
  </ItemGroup>
</Project>
