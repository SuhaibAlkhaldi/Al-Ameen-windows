{
  "ConnectionStrings": {
    "CompanyDlp": "Server=localhost;Database=CompanyDlpAdmin;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "AutoMigrate": false
  },
  "Jwt": {
    "Issuer": "CompanyDlp.AdminApi",
    "Audience": "CompanyDlp.AdminPortal",
    "SigningKey": "SET_WITH_CompanyDlp__Jwt__SigningKey_OR_USER_SECRETS_MINIMUM_32_BYTES",
    "AccessTokenMinutes": 60
  },
  "Onboarding": {
    "AllowPublicOnboarding": false
  },
  "AgentSecurity": {
    "DeviceTokenDays": 90,
    "EnrollmentCodeMinutes": 30
  },
  "PolicyDelivery": {
    "Mode": "Production",
    "PublicBaseUrl": "https://dlp-api.example.com",
    "SnapshotLifetimeMinutes": 1440,
    "AllowUnsignedDevelopmentSnapshots": false,
    "SigningPrivateKeyPem": "",
    "SigningPrivateKeyPath": ""
  },
  "DataProtection": {
    "KeyRingPath": "%PROGRAMDATA%\\CompanyDlp\\AdminApi\\DataProtectionKeys"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  }
}
