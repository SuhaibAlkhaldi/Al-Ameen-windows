# Build outputs
bin/
obj/
.vs/
*.user
*.suo
*.log

# Node / frontend outputs
node_modules/
dist/
.angular/

# Local development/runtime data
.development/
*.bak
*.tmp
artifacts/
browser-extension/build/

# Backup files
*.backup
*.old
*.before-*

# Company DLP local runtime files
audit-*.jsonl
policy.development.local.json
policy.production.local.json

# Secrets / credentials
*.pfx
*.cer
*.key
*.pem
*.secret
secrets.json
appsettings.*.local.json

# Extension signing material (private key + derived artifacts) - never commit
signing/

# Local-test-only secret material (keypairs, certs) - never commit
secrets/

# OS files
.DS_Store
Thumbs.db

# Local-only AI model assets (large binaries, ~1.1GB - deployed separately, never committed).
# Ignored by extension rather than the whole AiModel/ directory specifically so that directory's own
# README.md (documenting where these files come from and where a backup lives) stays tracked - git
# cannot re-include a file under a directory that's excluded wholesale, only under one excluded by
# narrower patterns like these.
src/CompanyDlp.Service/AiModel/*.onnx
src/CompanyDlp.Service/AiModel/*.model

# Ad-hoc local backup/scratch copies of the AI model files (e.g. before swapping in a new delivery
# from the AI team) get created as siblings of AiModel/ - deliberately outside that directory so the
# .csproj's <None Include="AiModel\**" .../> publish rule never bundles a 1GB+ backup into build
# output. Sibling-of-AiModel means the two rules above (which only match inside AiModel/ itself)
# don't cover them, so they need their own explicit ignore rule here.
src/CompanyDlp.Service/AiModel-backup-*/
src/CompanyDlp.Service/AiModel-incoming*/

# Local-only Tesseract OCR language data (deployed separately, never committed)
src/CompanyDlp.Service/TessData/
